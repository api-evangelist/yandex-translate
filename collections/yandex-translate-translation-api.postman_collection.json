          "name": "Translate text",
          "request": {
            "name": "Translate text",
            "description": {
              "content": "Translates the text to the specified language. Supports translating arrays of strings, auto-detection of source language, HTML format, and custom glossaries.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "translate",
                "v2",
                "translate"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetLanguageCode\": \"<string>\",\n  \"texts\": [\n    \"<string>\"\n  ],\n  \"sourceLanguageCode\": \"<string>\",\n  \"format\": \"PLAIN_TEXT\",\n  \"folderId\": \"<string>\",\n  \"model\": \"<string>\",\n  \"glossaryConfig\": {\n    \"glossaryData\": {\n      \"glossaryPairs\": [\n        {\n          \"sourceText\": \"<string>\",\n          \"translatedText\": \"<string>\",\n          \"exact\": false\n        }\n      ]\n    }\n  },\n  \"speller\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
